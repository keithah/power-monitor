# Copy to .env and fill in. Never commit .env.

# Enphase Enlighten
ENPHASE_USERNAME=
ENPHASE_PASSWORD=
# Optional LAN fallback if Enlighten site listing is unavailable
# ENPHASE_DISCOVERY_CIDRS=192.168.1.0/24

# Emporia Vue (Cognito login; usage is collected via the v1 API)
EMPORIA_EMAIL=
EMPORIA_PASSWORD=

# Utility via Opower (PG&E MFA is supported)
PGE_USERNAME=
PGE_PASSWORD=
PGE_UTILITY=Pacific Gas and Electric Company (PG&E)

# Optional
# DATA_DIR=/data
# PORT=8080
# COLLECT_INTERVAL_SECONDS=900
# SOLAR_URL=http://127.0.0.1:8094
